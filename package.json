{
  "name": "@bondarewicz/dreamteam",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Dream Team — a Claude Code agent roster with a cross-provider, schema-enforced eval harness (Claude, Ollama, Gemini, Codex). Bun-only.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondarewicz/dreamteam.git"
  },
  "homepage": "https://github.com/bondarewicz/dreamteam#readme",
  "bugs": {
    "url": "https://github.com/bondarewicz/dreamteam/issues"
  },
  "bin": {
    "dreamteam": "bin/dreamteam.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "bin",
    "adapters",
    "scripts",
    "agents",
    "commands",
    "schemas",
    "evals/src",
    "evals/*/scenario-*.md",
    "evals/README.md",
    "evals/draft-template.md",
    "evals/package.json",
    "evals/tsconfig.json",
    "web/index.ts",
    "web/package.json",
    "web/tsconfig.json",
    "web/README.md",
    "web/src",
    "web/static",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test evals/src/__tests__/ web/src/__tests__/",
    "pack:check": "npm pack --dry-run",
    "version:beta": "npm version prerelease --preid beta --no-git-tag-version",
    "publish:beta": "npm publish --tag beta --access public",
    "publish:stable": "npm publish --access public"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "zod": "^4.0.0"
  }
}
